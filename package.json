{
  "name": "dsh-auto-translate",
  "version": "0.4.3",
  "description": "Zero-token on-demand translation for the DeepSeek Harness web GUI: hover a block to translate it in place, drag-select text for a popup or in-place translation. Never auto-translates the page.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "metrics.mjs",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "DEV-STATE.md",
    "demo/hover-flow.svg",
    "demo/panel.png",
    "demo/hover-1-original.png",
    "demo/hover-2-translated.png",
    "demo/hover-3-restored.png",
    "scripts",
    "vendor/worker.v5.js",
    "vendor/transformers.esm.v2.js",
    "vendor/ort/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "translate",
    "translation",
    "i18n",
    "on-device",
    "wasm",
    "transformers.js",
    "onnxruntime"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gst20060726/dsh-auto-translate.git"
  },
  "homepage": "https://github.com/gst20060726/dsh-auto-translate#readme",
  "bugs": {
    "url": "https://github.com/gst20060726/dsh-auto-translate/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/contract.test.mjs test/i18n.test.mjs test/e2e.dom.test.mjs",
    "fetch-vendor": "node scripts/fetch-vendor.mjs",
    "status": "powershell -ExecutionPolicy Bypass -File scripts/status.ps1",
    "dashboard": "node scripts/dashboard.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "capture:demo": "node scripts/capture-demo.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.0.1"
  }
}
